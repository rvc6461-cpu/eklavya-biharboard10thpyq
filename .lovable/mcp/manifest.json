{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rtwzxjelobyumkmqqgrx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "eklavya-mcp",
      "version": "0.1.0",
      "title": "Eklavya – Bihar Board 10th"
    },
    "tools": [
      {
        "name": "list_subjects",
        "title": "List subjects",
        "description": "List all Bihar Board Class 10 subjects available in Eklavya, with their id, name, and number of chapters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_chapters",
        "title": "List chapters",
        "description": "List all chapters for a given subject id. Returns chapter id, name, and question count for each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subjectId": {
              "type": "string",
              "minLength": 1,
              "description": "Subject id from list_subjects, e.g. 'math' or 'sanskrit'."
            }
          },
          "required": [
            "subjectId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_questions",
        "title": "List questions",
        "description": "List all previous year questions (PYQ) for a given subject and chapter. Returns each question's id, year, text, options, correct answer index, and explanation.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subjectId": {
              "type": "string",
              "minLength": 1,
              "description": "Subject id from list_subjects."
            },
            "chapterId": {
              "type": "string",
              "minLength": 1,
              "description": "Chapter id from list_chapters."
            }
          },
          "required": [
            "subjectId",
            "chapterId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_questions",
        "title": "Search questions",
        "description": "Case-insensitive substring search across every PYQ question text in Eklavya. Returns matching questions with their subject and chapter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Search text, e.g. 'Pythagoras' or 'सन्धि'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
